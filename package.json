{
  "name": "doc2toon",
  "version": "0.1.0",
  "description": "Profile-first document-to-TOON CLI that measures character and token savings before claiming them.",
  "license": "MIT",
  "author": "Kyle Greenwell",
  "keywords": [
    "toon",
    "token-oriented-object-notation",
    "llm",
    "token-efficiency",
    "markdown",
    "text-processing",
    "document-conversion",
    "typescript",
    "cli",
    "netlify"
  ],
  "type": "module",
  "bin": {
    "doc2toon": "./dist/cli.js",
    "toon-doc": "./dist/cli.js"
  },
  "files": [
    "dist",
    "examples",
    "docs/github-release-v0.1.0.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "smoke": "bash scripts/smoke.sh",
    "dev": "tsx src/cli.ts",
    "convert:sample": "tsx src/cli.ts convert fixtures/sample.md --mode lossless --out fixtures/sample.toon --json-sidecar --stats"
  },
  "dependencies": {
    "@toon-format/toon": "2.3.0",
    "commander": "^14.0.2",
    "tokenx": "1.3.0"
  },
  "devDependencies": {
    "@toon-format/cli": "2.3.0",
    "@types/node": "^25.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=20"
  }
}
